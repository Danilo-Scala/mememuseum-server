# Copia questo file in .env e inserisci i tuoi valori.
# Il file .env è escluso da Git: non committare mai credenziali reali.

# Connessione a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Chiave per firmare i token JWT: usa una stringa lunga e casuale
JWT_SECRET="sostituisci-con-una-chiave-casuale"

# Porta del server (facoltativa, predefinita 5000)
PORT=5000
